{
  "name": "codex-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "基于本机 Codex app-server 的浏览器客户端",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @codex-web/client",
    "build": "npm run build --workspace @codex-web/client",
    "start": "node --env-file-if-exists=.env server/src/server.mjs",
    "start:backend": "node --env-file-if-exists=.env scripts/start-backend.mjs",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --test client/tests/*.test.js server/tests/*.test.mjs",
    "test:components": "node scripts/test-components.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build",
    "service:install": "node --env-file-if-exists=.env scripts/install-services.mjs",
    "service:restart": "systemctl --user restart codex-lan-web.service",
    "service:status": "systemctl --user status codex-lan-web.service codex-app-server.service --no-pager",
    "service:restart-when-idle": "node --env-file-if-exists=.env scripts/restart-when-idle.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "react-test-renderer": "19.3.1",
    "react": "19.3.1"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
